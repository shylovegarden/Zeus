{
  "name": "zeus",
  "displayName": "Zeus Language",
  "description": "Syntax highlighting and Language Server for the Zeus programming language",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zeus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zeus",
        "aliases": [
          "Zeus",
          "zeus"
        ],
        "extensions": [
          ".zs",
          ".zeus",
          ".shy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zeus",
        "scopeName": "source.zeus",
        "path": "./syntaxes/zeus.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.8.4"
  }
}
