{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zeus",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zeus",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zeus",
          "match": "\\b(if|else|for|in|return|parallel|target|proof)\\b"
        },
        {
          "name": "keyword.declaration.zeus",
          "match": "\\b(let|mut|fn)\\b"
        },
        {
          "name": "keyword.other.zeus",
          "match": "\\b(safe|unsafe)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.zeus",
          "match": "\\b(tensor|f64|f32|i64|i32|u64|u32|u8|bool)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.zeus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zeus",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.zeus",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.zeus",
          "match": "(=|\\+|-|\\*|/|>|<|==|!=|->|\\.\\.)"
        }
      ]
    }
  },
  "scopeName": "source.zeus"
}
